{
  "name": "Calm Quest Design System",
  "version": "1.0.0",
  "description": "Complete design tokens for the Calm Quest wellness app — calm, soothing, earth-toned aesthetic",

  "colors": {
    "primary": {
      "50": "#eef7f0",
      "100": "#d5ecda",
      "200": "#aed9b8",
      "300": "#7bc292",
      "400": "#4ea86e",
      "500": "#2d8a4e",
      "600": "#1f6e3d",
      "700": "#1a5832",
      "800": "#17472a",
      "900": "#133a23",
      "950": "#0a2013"
    },
    "secondary": {
      "50": "#eef4ff",
      "100": "#d9e6ff",
      "200": "#bcd3ff",
      "300": "#8eb6ff",
      "400": "#5990ff",
      "500": "#336bff",
      "600": "#1a49e8",
      "700": "#1337c4",
      "800": "#1630a0",
      "900": "#182d7e",
      "950": "#111d4d"
    },
    "accent": {
      "50": "#fcf4e8",
      "100": "#f8e5c7",
      "200": "#f1ca8c",
      "300": "#e9ab4f",
      "400": "#e39223",
      "500": "#d47918",
      "600": "#bb5e12",
      "700": "#9b4413",
      "800": "#7e3617",
      "900": "#692e17",
      "950": "#3c1609"
    },
    "neutral": {
      "50": "#fafaf9",
      "100": "#f0efed",
      "200": "#ddd9d4",
      "300": "#c1bbb2",
      "400": "#a59c8f",
      "500": "#908475",
      "600": "#7e7264",
      "700": "#685e52",
      "800": "#574e45",
      "900": "#4a433c",
      "950": "#27231e"
    },
    "calm": {
      "mist": "#d6e8e8",
      "foam": "#b8d4d4",
      "sage": "#9caea9",
      "stone": "#8b8174",
      "sand": "#d4c9b8",
      "dawn": "#f5ebe0",
      "dusk": "#7b8b8f",
      "sky": "#c9dbe9",
      "ocean": "#7a9eb3",
      "forest": "#5c7a6a"
    },
    "semantic": {
      "success": "#2d8a4e",
      "warning": "#e9ab4f",
      "error": "#c44a4a",
      "info": "#5990ff"
    },
    "surface": {
      "background": "#f7f5f1",
      "card": "#ffffff",
      "modal": "#ffffff",
      "overlay": "rgba(39, 35, 30, 0.6)",
      "elevated": "#ffffff"
    },
    "text": {
      "primary": "#27231e",
      "secondary": "#685e52",
      "tertiary": "#908475",
      "inverse": "#fafaf9",
      "disabled": "#c1bbb2"
    }
  },

  "typography": {
    "fontFamily": {
      "heading": "'Playfair Display', 'Georgia', serif",
      "body": "'Inter', 'SF Pro Text', -apple-system, sans-serif",
      "mono": "'JetBrains Mono', 'SF Mono', monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem",
      "5xl": "3rem",
      "6xl": "3.75rem"
    },
    "fontWeight": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.15,
      "normal": 1.5,
      "relaxed": 1.75,
      "loose": 2
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "normal": "0em",
      "wide": "0.05em",
      "wider": "0.1em"
    },
    "textStyles": {
      "h1": {
        "fontFamily": "heading",
        "fontSize": "3rem",
        "fontWeight": "bold",
        "lineHeight": "tight",
        "letterSpacing": "tight"
      },
      "h2": {
        "fontFamily": "heading",
        "fontSize": "2.25rem",
        "fontWeight": "semibold",
        "lineHeight": "tight",
        "letterSpacing": "normal"
      },
      "h3": {
        "fontFamily": "heading",
        "fontSize": "1.5rem",
        "fontWeight": "semibold",
        "lineHeight": "normal",
        "letterSpacing": "normal"
      },
      "h4": {
        "fontFamily": "heading",
        "fontSize": "1.25rem",
        "fontWeight": "medium",
        "lineHeight": "normal",
        "letterSpacing": "normal"
      },
      "body": {
        "fontFamily": "body",
        "fontSize": "1rem",
        "fontWeight": "regular",
        "lineHeight": "relaxed",
        "letterSpacing": "normal"
      },
      "bodySmall": {
        "fontFamily": "body",
        "fontSize": "0.875rem",
        "fontWeight": "regular",
        "lineHeight": "normal",
        "letterSpacing": "normal"
      },
      "caption": {
        "fontFamily": "body",
        "fontSize": "0.75rem",
        "fontWeight": "regular",
        "lineHeight": "normal",
        "letterSpacing": "wide"
      },
      "button": {
        "fontFamily": "body",
        "fontSize": "0.875rem",
        "fontWeight": "semibold",
        "lineHeight": "normal",
        "letterSpacing": "wider",
        "textTransform": "uppercase"
      },
      "quote": {
        "fontFamily": "heading",
        "fontSize": "1.25rem",
        "fontWeight": "regular",
        "fontStyle": "italic",
        "lineHeight": "relaxed",
        "letterSpacing": "normal"
      }
    }
  },

  "spacing": {
    "0": "0px",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem",
    "16": "4rem",
    "20": "5rem",
    "24": "6rem"
  },

  "borderRadius": {
    "none": "0px",
    "sm": "0.375rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.5rem",
    "3xl": "2rem",
    "full": "9999px"
  },

  "shadows": {
    "sm": "0 1px 2px rgba(39, 35, 30, 0.05)",
    "md": "0 4px 6px -1px rgba(39, 35, 30, 0.08)",
    "lg": "0 10px 15px -3px rgba(39, 35, 30, 0.1)",
    "xl": "0 20px 25px -5px rgba(39, 35, 30, 0.12)",
    "2xl": "0 25px 50px -12px rgba(39, 35, 30, 0.2)",
    "inner": "inset 0 2px 4px rgba(39, 35, 30, 0.05)",
    "glow": "0 0 20px rgba(45, 138, 78, 0.15)",
    "glowWarm": "0 0 20px rgba(233, 171, 79, 0.15)"
  },

  "animation": {
    "duration": {
      "instant": "100ms",
      "fast": "200ms",
      "normal": "300ms",
      "slow": "500ms",
      "gentle": "800ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "calm": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "breathe": "cubic-bezier(0.65, 0, 0.35, 1)",
      "spring": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
    },
    "keyframes": {
      "fadeIn": {
        "from": { "opacity": 0 },
        "to": { "opacity": 1 }
      },
      "slideUp": {
        "from": { "opacity": 0, "transform": "translateY(10px)" },
        "to": { "opacity": 1, "transform": "translateY(0)" }
      },
      "breatheIn": {
        "from": { "transform": "scale(0.85)", "opacity": 0.7 },
        "to": { "transform": "scale(1)", "opacity": 1 }
      },
      "breatheOut": {
        "from": { "transform": "scale(1)", "opacity": 1 },
        "to": { "transform": "scale(0.85)", "opacity": 0.7 }
      },
      "pulseSoft": {
        "0%, 100%": { "opacity": 1 },
        "50%": { "opacity": 0.7 }
      }
    }
  },

  "components": {
    "button": {
      "primary": {
        "backgroundColor": "primary.500",
        "color": "text.inverse",
        "borderRadius": "lg",
        "paddingX": "6",
        "paddingY": "3",
        "fontSize": "sm",
        "fontWeight": "semibold",
        "letterSpacing": "wider",
        "textTransform": "uppercase",
        "shadow": "sm",
        "hover": {
          "backgroundColor": "primary.600",
          "shadow": "md"
        },
        "active": {
          "backgroundColor": "primary.700"
        },
        "disabled": {
          "backgroundColor": "neutral.300",
          "color": "text.disabled"
        }
      },
      "secondary": {
        "backgroundColor": "transparent",
        "borderColor": "primary.500",
        "borderWidth": "2px",
        "color": "primary.600",
        "borderRadius": "lg",
        "paddingX": "6",
        "paddingY": "2.5",
        "fontSize": "sm",
        "fontWeight": "semibold",
        "letterSpacing": "wider",
        "textTransform": "uppercase",
        "hover": {
          "backgroundColor": "primary.50",
          "borderColor": "primary.600"
        }
      },
      "ghost": {
        "backgroundColor": "transparent",
        "color": "text.secondary",
        "borderRadius": "lg",
        "paddingX": "4",
        "paddingY": "2",
        "hover": {
          "backgroundColor": "neutral.100",
          "color": "text.primary"
        }
      }
    },
    "card": {
      "default": {
        "backgroundColor": "surface.card",
        "borderRadius": "xl",
        "shadow": "md",
        "padding": "6"
      },
      "elevated": {
        "backgroundColor": "surface.card",
        "borderRadius": "2xl",
        "shadow": "lg",
        "padding": "8"
      },
      "glass": {
        "backgroundColor": "rgba(255, 255, 255, 0.7)",
        "backdropFilter": "blur(20px)",
        "borderRadius": "2xl",
        "border": "1px solid rgba(255, 255, 255, 0.3)",
        "shadow": "lg",
        "padding": "6"
      }
    },
    "input": {
      "default": {
        "backgroundColor": "surface.card",
        "borderColor": "neutral.300",
        "borderWidth": "1px",
        "borderRadius": "lg",
        "paddingX": "4",
        "paddingY": "3",
        "color": "text.primary",
        "placeholderColor": "text.tertiary",
        "focus": {
          "borderColor": "primary.400",
          "shadow": "0 0 0 3px rgba(45, 138, 78, 0.15)"
        }
      }
    },
    "tab": {
      "default": {
        "color": "text.secondary",
        "paddingY": "3",
        "paddingX": "4",
        "active": {
          "color": "primary.600",
          "borderBottom": "2px solid",
          "borderColor": "primary.500"
        }
      }
    }
  },

  "gradients": {
    "calmMorning": "linear-gradient(135deg, #f5ebe0 0%, #d6e8e8 50%, #c9dbe9 100%)",
    "calmForest": "linear-gradient(135deg, #eef7f0 0%, #aed9b8 50%, #7bc292 100%)",
    "calmOcean": "linear-gradient(135deg, #c9dbe9 0%, #b8d4d4 50%, #7a9eb3 100%)",
    "calmSunset": "linear-gradient(135deg, #f5ebe0 0%, #f1ca8c 50%, #d47918 100%)",
    "calmDusk": "linear-gradient(135deg, #d6e8e8 0%, #7b8b8f 50%, #5c7a6a 100%)",
    "cardGlow": "linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(45,138,78,0.03) 100%)"
  },

  "layouts": {
    "maxWidth": {
      "mobile": "430px",
      "tablet": "768px",
      "desktop": "1024px"
    },
    "bottomNav": {
      "height": "64px",
      "backgroundColor": "#ffffff",
      "borderTop": "1px solid",
      "borderColor": "neutral.200"
    },
    "header": {
      "height": "56px",
      "backgroundColor": "transparent"
    }
  },

  "iconography": {
    "style": "rounded, line-based with 1.5px stroke",
    "sizes": {
      "sm": "16px",
      "md": "20px",
      "lg": "24px",
      "xl": "32px"
    },
    "color": "text.secondary"
  },

  "tailwindPreset": {
    "extend": {
      "colors": {
        "primary": { "50": "#eef7f0", "100": "#d5ecda", "200": "#aed9b8", "300": "#7bc292", "400": "#4ea86e", "500": "#2d8a4e", "600": "#1f6e3d", "700": "#1a5832", "800": "#17472a", "900": "#133a23", "950": "#0a2013" },
        "secondary": { "50": "#eef4ff", "100": "#d9e6ff", "200": "#bcd3ff", "300": "#8eb6ff", "400": "#5990ff", "500": "#336bff", "600": "#1a49e8", "700": "#1337c4", "800": "#1630a0", "900": "#182d7e", "950": "#111d4d" },
        "accent": { "50": "#fcf4e8", "100": "#f8e5c7", "200": "#f1ca8c", "300": "#e9ab4f", "400": "#e39223", "500": "#d47918", "600": "#bb5e12", "700": "#9b4413", "800": "#7e3617", "900": "#692e17", "950": "#3c1609" },
        "calm-mist": "#d6e8e8",
        "calm-foam": "#b8d4d4",
        "calm-sage": "#9caea9",
        "calm-stone": "#8b8174",
        "calm-sand": "#d4c9b8",
        "calm-dawn": "#f5ebe0",
        "calm-dusk": "#7b8b8f",
        "calm-sky": "#c9dbe9",
        "calm-ocean": "#7a9eb3",
        "calm-forest": "#5c7a6a"
      },
      "fontFamily": {
        "heading": ["Playfair Display", "Georgia", "serif"],
        "body": ["Inter", "SF Pro Text", "system-ui", "sans-serif"]
      },
      "borderRadius": {
        "4xl": "2rem"
      },
      "boxShadow": {
        "glow": "0 0 20px rgba(45, 138, 78, 0.15)",
        "glow-warm": "0 0 20px rgba(233, 171, 79, 0.15)"
      }
    }
  }
}
